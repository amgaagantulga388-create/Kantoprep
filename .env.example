# ==============================================================================
# KantoPrep - 100% Free Tier Environment Variables
# ==============================================================================
# 1. Create a free project at https://supabase.com
# 2. In Project Settings -> API, copy your Project URL and anon public key
# 3. Rename this file to .env.local and paste your credentials below:

NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Optional: To restrict pilot exclusively to a single school during Phase 1:
NEXT_PUBLIC_PILOT_SCHOOL_DOMAIN=bst.ac.jp
